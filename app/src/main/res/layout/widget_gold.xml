<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/gold_widget_ball"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/gold_widget_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ЗОЛОТО ЦБ"
            android:textColor="#513300"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gold_widget_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#382100"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₽ / грамм"
            android:textColor="#513300"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gold_widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Нет данных"
            android:textColor="#513300"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>